# Required: absolute path to the user's own Obsidian vault.
OBSIDIAN_VAULT=D:\\My Obsidian Vault

# Optional local service settings.
LITERATURE_WORKBENCH_PORT=8765
LITERATURE_WORKBENCH_DATA_DIR=D:\\Literature Workbench Data
ZOTERO_LOCAL_API=http://127.0.0.1:23119/api/users/0
LITERATURE_WORKBENCH_PYTHON=python

# Optional Codex CLI integration. Most users can leave these unset.
# CODEX_HOME=C:\\Users\\your-name\\.codex
# CODEX_CLI_PATH=C:\\path\\to\\codex.exe

# Optional model providers. Never commit real keys.
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_COMPATIBLE_API_KEY=...
